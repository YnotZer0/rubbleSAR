[Unit]
Description=RubbleSAR casualty-analyst (receives, stores and acknowledges detections)
Documentation=file:///opt/rubblesar/docs
After=network-online.target zenohd.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=rubblesar
Group=rubblesar
Environment=RUST_LOG=error
Environment=NO_COLOR=1
ExecStart=/opt/rubblesar/bin/casualty-analyst run --config /etc/rubblesar/sar.toml
WorkingDirectory=/var/lib/rubblesar/detections
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
LimitNOFILE=65536
# Hardening: it needs the network and its detection store only.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/rubblesar/detections
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
