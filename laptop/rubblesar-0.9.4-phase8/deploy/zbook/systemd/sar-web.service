[Unit]
Description=RubbleSAR sar-web (the offline incident map, the live operator view, the after-action reports and the demo presenter)
Documentation=file:///opt/rubblesar/docs
After=network-online.target zenohd.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=rubblesar
Group=rubblesar
Environment=NO_COLOR=1
Environment=RUST_LOG=error
ExecStart=/opt/rubblesar/bin/sar-web run --config /etc/rubblesar/sar.toml
WorkingDirectory=/var/lib/rubblesar/www
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
# Hardening: read-only; it serves files and the live picture from the bus.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
