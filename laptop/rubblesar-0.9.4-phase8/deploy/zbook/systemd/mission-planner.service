[Unit]
Description=RubbleSAR mission-planner (sends investigators to casualties that need a close look)
Documentation=file:///opt/rubblesar/docs
After=network-online.target zenohd.service casualty-analyst.service
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=rubblesar
Group=rubblesar
Environment=RUST_LOG=error
Environment=NO_COLOR=1
ExecStart=/opt/rubblesar/bin/mission-planner run --config /etc/rubblesar/sar.toml
WorkingDirectory=/var/lib/rubblesar/planner
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
# Hardening: it needs the network and its task file only.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/rubblesar/planner
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
