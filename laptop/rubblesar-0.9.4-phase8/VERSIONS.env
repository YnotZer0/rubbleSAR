# Pinned versions and checksums used by the setup scripts. Do not edit by hand
# unless you are deliberately upgrading; zenoh-c and zenohd must stay equal.
GO_VERSION=1.26.0
ZENOH_VERSION=1.9.0

# SHA-256 of the official release archives from github.com/eclipse-zenoh
ZENOH_C_SHA256_X86_64=29f6a0dedc7ada0be007058e706df64ff26e62ae56f6efc2b098132c431c263d
ZENOH_C_SHA256_AARCH64=0cc12b7a87b9b9a8897318d054a7f447c601ac517a238b8c9edb14f2bd2c5d16
ZENOHD_SHA256_X86_64=f18081184b089e79e605f2c0cb3f7790fbf101ae94942988f716e19e1810a46e
ZENOHD_SHA256_AARCH64=34e24153dcf69e18f407eb1d2921226a273960cfaa03cefceb452d16434341e7

# Go archives are verified against the checksum published on go.dev at install time.

# ---------------------------------------------------------------- phase 2
# ONNX Runtime (CPU) for model evaluation in Go: github.com/microsoft/onnxruntime releases
ONNXRUNTIME_VERSION=1.22.0
ONNXRUNTIME_SHA256_X86_64=8344d55f93d5bc5021ce342db50f62079daf39aaafb5d311a451846228be49b3
ONNXRUNTIME_SHA256_AARCH64=bb76395092d150b52c7092dc6b8f2fe4d80f0f3bf0416d2f269193e347e24702

# Training (ZBook, Docker): Ultralytics YOLO11 segmentation (AGPL-3.0, decision D2)
ULTRALYTICS_VERSION=8.3.253
# CUDA 12.8 images need NVIDIA driver 570 or newer; older drivers use the fallback image.
TRAIN_BASE_IMAGE=pytorch/pytorch:2.9.1-cuda12.8-cudnn9-runtime
TRAIN_BASE_IMAGE_FALLBACK=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
TRAIN_MIN_DRIVER=570
# Starting weights from github.com/ultralytics/assets (release v8.3.0) and the plotting font (v0.0.0)
YOLO11S_SEG_SHA256=1caa81c0195412efa411b632bcfb8c184939dddb6ae41f6a80c41b211ff257c3
YOLO11N_SEG_SHA256=55ed65c56c91713d23e8402371c6c49a6fd84f257f7dce452e8d70e41dcbe152
YOLO11N_SHA256=0ebbc80d4a7680d14987a577cd21342b65ecfd94632bd9a8da63ae6417644ee1
ARIAL_TTF_SHA256=525979822591a3447cfc49d943d6f7683508e25543407871c0ed8fed05fd2bd9

# ---------------------------------------------------------------- phase 5
# TAK server (ZBook, Docker): taky from PyPI (MIT), on plain TCP 8087
TAKY_VERSION=0.10
TAKY_BASE_IMAGE=python:3.11-slim
